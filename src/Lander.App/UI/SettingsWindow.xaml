<Window x:Class="Lander.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lander.App.UI"
        Title="Ajustes de Lander"
        Width="880" Height="680" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Galería de aspectos -->
    <DataTemplate x:Key="SkinTemplate">
      <Grid Width="112" Height="124" Margin="2" ToolTip="{Binding Description}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{Binding Preview}" Width="72" Height="72" />
          <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding LockText}" HorizontalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource SymbolFont}" FontSize="14" Margin="6"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
      </Grid>
    </DataTemplate>

    <!-- Estelas -->
    <DataTemplate x:Key="TrailTemplate">
      <StackPanel Width="96" Margin="2,6" ToolTip="{Binding Description}">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Ellipse Width="32" Height="32" Fill="{Binding Swatch}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Text="{Binding LockText}" HorizontalAlignment="Center" FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
      <WrapPanel />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navegación -->
    <DockPanel Margin="12,16,4,16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,20">
        <Image Source="{Binding AppIcon}" Width="40" Height="40" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Lander" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LevelSummary}" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </StackPanel>

      <ListBox x:Name="Navigation" SelectedIndex="0" Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource NavigationItemStyle}"
               SelectionChanged="OnNavigationChanged">
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="General" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE771;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Aspecto" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE76E;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Comportamiento" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Pilotaje" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE767;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Sonido" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE734;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Piloto" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE946;" FontFamily="{StaticResource SymbolFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Acerca de" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
    </DockPanel>

    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,28,24">
      <Grid MaxWidth="820" HorizontalAlignment="Stretch">

        <!-- General ======================================================================= -->
        <StackPanel x:Name="GeneralPage">
          <TextBlock Text="General" Style="{StaticResource PageTitleStyle}" />

          <ui:SettingCard Glyph="&#xE7E8;" Header="Iniciar con Windows" Description="El lander aparece en la barra de tareas al iniciar sesión.">
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE769;" Header="Pausar" Description="Aterriza donde esté y se queda quieto. También con un clic en el icono de la bandeja.">
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Paused}" />
          </ui:SettingCard>

          <TextBlock Text="Modo manual" Style="{StaticResource SectionHeaderStyle}" />
          <ui:SettingCard Glyph="&#xE765;" Header="Atajo para tomar el control" Description="{Binding HotkeyStatus}">
            <ui:HotkeyBox Hotkey="{Binding Hotkey}" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE916;" Header="Devolver el control automáticamente" Description="Si no tocas ninguna tecla durante este tiempo, el lander vuelve a volar solo.">
            <StackPanel Orientation="Horizontal">
              <Slider Width="180" Minimum="10" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                      Value="{Binding ManualTimeout}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ManualTimeoutText}" Width="48" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
            </StackPanel>
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE7FC;" Header="Pilotar ahora" Description="Toma o devuelve el control sin usar el teclado.">
            <Button Content="{Binding ControlButtonText}" Command="{Binding ToggleControlCommand}" MinWidth="160" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE7C1;" Header="Carrera contrarreloj" Description="Se ponen balizas numeradas sobre tus ventanas: posa el lander en cada una, en orden, y vuelve a la base. El cronómetro arranca al despegar.">
            <Button Content="Empezar" Command="{Binding StartRaceCommand}" MinWidth="160" />
          </ui:SettingCard>
        </StackPanel>

        <!-- Aspecto ======================================================================= -->
        <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
          <TextBlock Text="Aspecto" Style="{StaticResource PageTitleStyle}" />

          <ui:SettingCard Glyph="&#xE740;" Header="Tamaño" Description="Altura del lander. Se ajusta además al escalado de cada monitor.">
            <StackPanel Orientation="Horizontal">
              <Slider Width="200" Minimum="32" Maximum="96" TickFrequency="4" IsSnapToTickEnabled="True"
                      Value="{Binding LanderSize}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LanderSizeText}" Width="52" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
            </StackPanel>
          </ui:SettingCard>

          <ui:SettingCard Glyph="&#xE790;" Header="Modelo" Description="Se desbloquean más modelos al subir de nivel pilotando." Wide="True">
            <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                     ItemTemplate="{StaticResource SkinTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                     ItemContainerStyle="{StaticResource GalleryItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          </ui:SettingCard>

          <ui:SettingCard Glyph="&#xE945;" Header="Estela del motor" Description="El color del humo." Wide="True">
            <ListBox ItemsSource="{Binding Trails}" SelectedItem="{Binding SelectedTrail}"
                     ItemTemplate="{StaticResource TrailTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                     ItemContainerStyle="{StaticResource GalleryItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          </ui:SettingCard>
        </StackPanel>

        <!-- Comportamiento ================================================================== -->
        <StackPanel x:Name="BehaviorPage" Visibility="Collapsed">
          <TextBlock Text="Comportamiento" Style="{StaticResource PageTitleStyle}" />

          <ui:SettingCard Glyph="&#xE9D9;" Header="Actividad" Description="Cada cuánto se anima a volar a otro sitio cuando está en automático.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Tranquilo" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Slider Width="180" Minimum="0.25" Maximum="3" Value="{Binding Activity}" VerticalAlignment="Center" />
              <TextBlock Text="Activo" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE8B0;" Header="Timidez" Description="Si huye del cursor cuando se le acerca o si, al contrario, lo sigue.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Lo sigue" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Slider Width="180" Minimum="0" Maximum="1" Value="{Binding Shyness}" VerticalAlignment="Center" />
              <TextBlock Text="Huye" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE7BA;" Header="Despistes del piloto" Description="Para que no parezca un robot: a veces calcula mal la frenada o llega torcido. Casi siempre acaba en un aterrizaje duro; muy de vez en cuando, en accidente.">
            <ComboBox SelectedIndex="{Binding PilotErrors}" MinWidth="160">
              <ComboBoxItem Content="Ninguno" />
              <ComboBoxItem Content="Pocos" />
              <ComboBoxItem Content="Normales" />
              <ComboBoxItem Content="Muchos" />
            </ComboBox>
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE823;" Header="Visitar el reloj a las horas en punto" Description="Vuela hasta el reloj de la barra de tareas y lo celebra (solo si estás delante del PC).">
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding VisitClock}" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xEA8F;" Header="Reaccionar a las notificaciones" Description="Da un saltito de sorpresa cuando llega una notificación.">
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ReactToNotifications}" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE7C9;" Header="Cogerlo con el ratón" Description="Arrástralo y suéltalo para lanzarlo. Doble clic para pilotarlo. Si lo desactivas, el ratón lo atraviesa siempre.">
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AllowDragging}" />
          </ui:SettingCard>

          <TextBlock Text="Misiones" Style="{StaticResource SectionHeaderStyle}" />
          <ui:SettingCard Glyph="&#xE7C1;" Header="Frecuencia de misiones" Description="De vez en cuando aparece un aviso junto al lander. Toma el control para aceptarla.">
            <ComboBox SelectedIndex="{Binding MissionFrequency}" MinWidth="160">
              <ComboBoxItem Content="Nunca" />
              <ComboBoxItem Content="Pocas" />
              <ComboBoxItem Content="Normal" />
              <ComboBoxItem Content="Muchas" />
            </ComboBox>
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE7C1;" Header="Proponer una misión ahora">
            <Button Content="Proponer" Command="{Binding OfferMissionCommand}" MinWidth="120" />
          </ui:SettingCard>
        </StackPanel>

        <!-- Pilotaje ========================================================================= -->
        <StackPanel x:Name="PilotingPage" Visibility="Collapsed">
          <TextBlock Text="Pilotaje" Style="{StaticResource PageTitleStyle}" />

          <TextBlock Text="Controles" Style="{StaticResource SectionHeaderStyle}" />
          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="16,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
              </Grid.RowDefinitions>
              <Border Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="↑" HorizontalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Motor principal: empuja hacia donde apunta la nave" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="←" HorizontalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="→" HorizontalAlignment="Center" /></Border>
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Girar con los propulsores de giro. Al soltar, mantienen la inclinación" VerticalAlignment="Center" TextWrapping="Wrap" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="A" HorizontalAlignment="Center" /></Border>
                <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="D" HorizontalAlignment="Center" /></Border>
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Desplazarse a un lado con los propulsores de traslación, sin girar" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Border Grid.Row="3" Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="↓" HorizontalAlignment="Center" /></Border>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="Enderezar la nave" VerticalAlignment="Center" />
              <Border Grid.Row="4" Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="G" HorizontalAlignment="Center" /></Border>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="Sacar o recoger las patas (sin patas, aterrizar es mucho más delicado)" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Border Grid.Row="5" Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="Espacio" /></Border>
              <TextBlock Grid.Row="5" Grid.Column="1" Text="Impulso de emergencia (gasta mucho combustible)" VerticalAlignment="Center" />
              <Border Grid.Row="6" Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="Esc" /></Border>
              <TextBlock Grid.Row="6" Grid.Column="1" Text="Soltar el control" VerticalAlignment="Center" />
              <Border Grid.Row="7" Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="Barra de tareas" /></Border>
              <TextBlock Grid.Row="7" Grid.Column="1" Text="La base: aterriza ahí para repostar y reparar daños" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock Text="Aterrizajes" Style="{StaticResource SectionHeaderStyle}" />
          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="16,12">
            <StackPanel>
              <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Perfecto · " /><Run Text="despacio, recto y con las dos patas sobre la plataforma. Puntos extra y las rachas multiplican." /></TextBlock>
              <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"><Run FontWeight="SemiBold" Text="Duro · " /><Run Text="algo rápido o inclinado. Menos puntos y un poco de daño." /></TextBlock>
              <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"><Run FontWeight="SemiBold" Text="Accidente · " /><Run Text="demasiado rápido o de lado. Pequeña explosión y vuelta a la base." /></TextBlock>
              <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,10,0,0" Text="Una ventana estrecha vale más que la barra de tareas. Sin combustible no hay motor: el lander cae como una piedra." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Sonido =========================================================================== -->
        <StackPanel x:Name="SoundPage" Visibility="Collapsed">
          <TextBlock Text="Sonido" Style="{StaticResource PageTitleStyle}" />
          <ui:SettingCard Glyph="&#xE767;" Header="Sonido" Description="Zumbido del motor, clic de las patas y pitido de aterrizaje. Siempre en silencio con «No molestar».">
            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding SoundEnabled}" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE995;" Header="Volumen" IsEnabled="{Binding SoundEnabled}">
            <StackPanel Orientation="Horizontal">
              <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding VolumeText}" Width="48" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
            </StackPanel>
          </ui:SettingCard>
        </StackPanel>

        <!-- Piloto =========================================================================== -->
        <StackPanel x:Name="PilotPage" Visibility="Collapsed">
          <TextBlock Text="Piloto" Style="{StaticResource PageTitleStyle}" />

          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="20,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="{Binding Level}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LevelSummary}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PointsText}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                <ProgressBar Value="{Binding LevelProgress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,4" />
                <TextBlock Text="{Binding NextLevelText}" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="Estadísticas" Style="{StaticResource SectionHeaderStyle}" />
          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,4,4">
                  <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryTextStyle}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding AchievementSummary}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            <TextBlock Text="Logros" Style="{StaticResource SectionHeaderStyle}" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding AchievementRows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,4,4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StateGlyph" Text="&#xE734;" FontFamily="{StaticResource SymbolFont}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="Bar" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource SecondaryTextStyle}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsEarned}" Value="True">
                    <Setter TargetName="StateGlyph" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="StateGlyph" Property="Opacity" Value="1" />
                    <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Desbloqueos" Style="{StaticResource SectionHeaderStyle}" />
          <ItemsControl ItemsSource="{Binding UnlockRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StateGlyph" Text="&#xE72E;" FontFamily="{StaticResource SymbolFont}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding LevelText}" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding KindText}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter TargetName="StateGlyph" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Acerca de ======================================================================== -->
        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
          <TextBlock Text="Acerca de" Style="{StaticResource PageTitleStyle}" />
          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="20,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="{Binding AppIcon}" Width="64" Height="64" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Lander" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Un pequeño módulo lunar que vive sobre tus ventanas y la barra de tareas, con física real de aterrizaje. Tu escritorio es la superficie de un planeta y tus ventanas son las plataformas de aterrizaje." />
                <TextBlock Margin="0,10,0,0">
                  <Hyperlink Command="{Binding OpenRepositoryCommand}">github.com/Kobayashi82/Lander</Hyperlink>
                </TextBlock>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="Datos" Style="{StaticResource SectionHeaderStyle}" />
          <ui:SettingCard Glyph="&#xE8B7;" Header="Carpeta de datos" Description="{Binding DataFolder}">
            <Button Content="Abrir" Command="{Binding OpenDataFolderCommand}" MinWidth="100" />
          </ui:SettingCard>
          <ui:SettingCard Glyph="&#xE777;" Header="Reiniciar progreso" Description="Borra puntos, nivel, estadísticas y desbloqueos. No se puede deshacer.">
            <Button Content="Reiniciar…" Command="{Binding ResetProgressCommand}" MinWidth="100" />
          </ui:SettingCard>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
