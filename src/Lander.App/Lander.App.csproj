<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lander</AssemblyName>
    <RootNamespace>Lander.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Lander.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- ThemeMode (tema Fluent de WPF) sigue marcado como experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lander.Core\Lander.Core.csproj" />
  </ItemGroup>

  <!-- Render por GPU: Direct2D sobre Direct3D 11, compuesto con DirectComposition. -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DirectComposition" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

</Project>
